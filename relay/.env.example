# Relay (Render)
PORT=4000
RELAY_URL=https://helix-t47s.onrender.com
DASHBOARD_URL=https://helix01.vercel.app

# Radon auth (https://radonsdk.xyz/docs)
RADON_SECRET=
DATABASE_URL=postgres://user:pass@localhost:5432/helix
RESEND_API_KEY=
RADON_EMAIL_FROM=Helix <auth@helix.dev>
# console = print codes in the terminal (default in development)
# resend  = actually email codes (needs a real RESEND_API_KEY)
# RADON_EMAIL_MODE=console

# Appwrite (tunnels, billing, request logs)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=

BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Optional recurring catalog product. Without this, checkout is a one-time ₦2,500 charge.
# BACHS_PRODUCT_ID=

# Render start command: pnpm start  (not pnpm dev)
