# ═══════════════════════════════════════════════════════════════════════════
# RELAY — Express server (Render)
# Copy to relay/.env for local dev
# ═══════════════════════════════════════════════════════════════════════════

PORT=4000
RELAY_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000

# Radon auth — RADON_SECRET + DATABASE_URL must match app
RADON_SECRET=
DATABASE_URL=postgres://helix:helix@localhost:5433/helix
RESEND_API_KEY=
RADON_EMAIL_FROM=Helix <auth@yourdomain.com>
# console = print codes in terminal (local dev)
# resend  = send emails (production)
RADON_EMAIL_MODE=console

# Appwrite
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=

# Bachs — webhook: https://helix-um9b.onrender.com/webhooks/bachs
# Render production: RELAY_URL=https://helix-um9b.onrender.com
RADON_BACHS_SECRET_KEY=
RADON_BACHS_WEBHOOK_SECRET=
BACHS_PRODUCT_ID=

# Render: pnpm start
